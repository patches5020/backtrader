# Crypto.com API credentials (optional -- only needed for authenticated
# endpoints; public OHLCV data works without keys)
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# Defaults
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
DEFAULT_LIMIT=200

SWING_LOOKBACK=50

# Money management (see cdcx/risk.py)
ATR_STOP_MULTIPLIER=1.5
RISK_PCT_PER_TRADE=2.0
DEFAULT_ACCOUNT_BALANCE=10000
GIVEBACK_EXIT_PCT=0.20

# Local paper-trade tracking file (see cdcx/trade_manager.py) -- this tool
# does not place live orders; it only tracks locally simulated trade state.
TRADE_STATE_PATH=cdcx_trades.json
