# Crypto.com API credentials (optional -- only needed for authenticated
# endpoints; public OHLCV data works without keys)
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# Optional Market Data License (MDLA) key for the Crypto.com Predictions
# API (see cdcx/predictions.py, --predictions*). Anonymous access (no key)
# already works, just at Crypto.com's lower rate limits.
PREDICTIONS_API_KEY=

# Defaults
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
DEFAULT_LIMIT=200

SWING_LOOKBACK=50

# Money management (see cdcx/risk.py)
# ATR_STOP_MULTIPLIER is the GLOBAL fallback -- used for any base currency
# not listed in ATR_MULTIPLIER_OVERRIDES below.
ATR_STOP_MULTIPLIER=1.5
# Per-symbol ATR multiplier overrides, keyed by BASE currency, format
# "BASE:MULT,BASE:MULT,...". A real 1000-bar 1h backtest sweep found XRP's
# empirical optimum was a tighter 1.0x (see README's "ATR-multiplier
# sensitivity" section) -- deliberately set back to the 1.5x global default
# here for one consistent multiplier across both traded symbols. Override
# per-run instead with --atr-multiplier on the CLI.
ATR_MULTIPLIER_OVERRIDES=BTC:1.5,XRP:1.5
# TP1-4 R-multiples of stop_distance, selectable at input (--tp-ratios
# overrides per-run). See risk.resolve_tp_ratios().
TP_RATIOS=2.2,2.6,3.2,4.5
# % of the ORIGINAL position size closed at each TP1-4 as it's reached
# (four values, 0-100). TP4 always closes 100% of whatever remains
# regardless of its own configured share here -- "TP4 -> close remaining
# position." See trade_manager.py's partial-close rules (G/H) and
# risk.resolve_tp_close_pcts(). --tp-close-pcts overrides per-run.
TP_CLOSE_PCTS=25,25,25,25
# How TP1-4 are computed: "atr" (default -- fixed R-multiples above) or
# "structural" (nearest real resistance/support -- volume-profile
# VAH/VAL/HVN/LVN, a Fibonacci extension rung, a swing high/low, or an
# active FVG edge; any rung without a real candidate falls back to its ATR
# level, so structural mode never returns fewer than 4 targets). Opt-in --
# --tp-mode overrides per-run. See risk.resolve_tp_mode() /
# risk.build_structural_tp_levels().
TP_MODE=atr
RISK_PCT_PER_TRADE=2.0
DEFAULT_ACCOUNT_BALANCE=10000
GIVEBACK_EXIT_PCT=0.20

# How many candles old the last fetched bar is allowed to be before the
# final no-trade gate (cdcx/no_trade_gate.py) blocks a --live order for
# stale market data.
MAX_DATA_STALENESS_BARS=3.0

# Software-level paper/live separation (see cdcx/no_trade_gate.py), fully
# independent of the --live CLI flag and the typed-YES confirmation prompt.
# --live refuses to send anything real unless TRADING_MODE=LIVE is ALSO set
# here -- this exists specifically so a stray --live on a machine still
# configured for paper testing can't accidentally place a real order.
# "PAPER" (default) or "LIVE" -- anything else is treated as PAPER.
TRADING_MODE=PAPER

# Local paper-trade tracking file (see cdcx/trade_manager.py) -- this tool
# does not place live orders; it only tracks locally simulated trade state.
TRADE_STATE_PATH=cdcx_trades.json

# Root directory for the on-disk audit trail (see cdcx/journal.py):
# trading/paper/{signals,simulated_orders,simulated_results,rejected}/
# trading/live/{approved,orders,executions,results}/, plus tax_records/ and
# ssa_records/ written by --export-tax.
TRADING_JOURNAL_DIR=trading
